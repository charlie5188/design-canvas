# Any React app. The canvas is a Vite page inside the app folder, so it
# resolves the app's own packages and source.
KIT_LABEL="React"
KIT_PARENT="design-canvas"
KIT_RUN="npx vite --config design-canvas/__CANVAS_NAME__/vite.config.mts"
KIT_CHECK="node_modules/react/package.json"
KIT_CHECK_HINT="install the app dependencies first"
